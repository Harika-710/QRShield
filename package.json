{
  "name": "qrshield",
  "version": "1.0.0",
  "description": "QRShield - Cybersecurity QR Code & URL Inspector",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev",
    "backend": "node --watch backend/server.js",
    "frontend": "npm run dev --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
